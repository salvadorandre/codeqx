---
interface Props {
  title: string;
  highlightText?: string;
  description: string;
}

const { title, highlightText, description } = Astro.props;

// Split the title to insert the highlighted text if provided
let titleStart = title;
let titleEnd = "";

if (highlightText) {
  const titleParts = title.split(highlightText);
  if (titleParts.length > 1) {
    titleStart = titleParts[0];
    titleEnd = titleParts[1];
  }
}
---

<!-- Hero Section -->
<section class="hero-section relative isolate overflow-hidden bg-gradient-to-b from-green-50 via-white to-white dark:from-secondary-900 dark:via-secondary-950 dark:to-secondary-950 pt-32 md:pt-40 pb-16 md:pb-20">
  <div class="woven-background absolute inset-0 -z-20 opacity-55 dark:opacity-20" aria-hidden="true"></div>
  <div class="absolute -left-28 top-16 -z-10 h-72 w-72 rounded-full bg-green-300/20 blur-3xl dark:bg-green-500/10" aria-hidden="true"></div>
  <div class="absolute -right-24 bottom-8 -z-10 h-64 w-64 rounded-full bg-accent-300/20 blur-3xl dark:bg-accent-400/10" aria-hidden="true"></div>

  <!-- Geometric details inspired by Guatemalan textiles -->
  <div class="textile-motif textile-motif-left absolute left-5 top-1/2 hidden -translate-y-1/2 opacity-30 lg:grid dark:opacity-20" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
  </div>
  <div class="textile-motif textile-motif-right absolute right-5 top-1/2 hidden -translate-y-1/2 opacity-30 lg:grid dark:opacity-20" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
    <span></span><span></span><span></span>
  </div>
  
  <div class="container-custom relative z-10">
    <div class="text-center max-w-4xl mx-auto px-4">
      <div class="mb-6 flex items-center justify-center gap-2 animate-fade-in" aria-hidden="true">
        <span class="h-px w-8 bg-green-700/40"></span>
        <span class="ornament-diamond bg-green-800"></span>
        <span class="ornament-diamond scale-75 bg-accent-500"></span>
        <span class="ornament-diamond bg-green-500"></span>
        <span class="h-px w-8 bg-green-700/40"></span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tight mb-5 md:mb-7 text-secondary-900 dark:text-white animate-slide-down">
        {highlightText ? (
          <>
            {titleStart}<span class="highlight-text relative inline-block text-green-700 dark:text-green-400">{highlightText}</span>{titleEnd}
          </>
        ) : (
          title
        )}
      </h1>
      <p class="mx-auto max-w-2xl text-lg md:text-xl text-secondary-600 dark:text-secondary-300 mb-6 md:mb-8 animate-slide-up" style="animation-delay: 200ms">
        {description}
      </p>
    </div>
  </div>

</section>

<style>
  .woven-background {
    background-image:
      repeating-linear-gradient(0deg, rgba(3, 77, 8, 0.045) 0, rgba(3, 77, 8, 0.045) 1px, transparent 1px, transparent 5px),
      repeating-linear-gradient(90deg, rgba(47, 171, 46, 0.035) 0, rgba(47, 171, 46, 0.035) 1px, transparent 1px, transparent 7px);
    mask-image: linear-gradient(to bottom, black 10%, transparent 94%);
  }

  .ornament-diamond {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 0.1rem;
    transform: rotate(45deg);
  }

  .highlight-text::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.12em;
    left: 0;
    height: 0.12em;
    border-radius: 9999px;
    background: repeating-linear-gradient(90deg, #034d08 0 12px, #3bc935 12px 24px, #d9e11a 24px 36px);
    opacity: 0.8;
  }

  .textile-motif {
    grid-template-columns: repeat(3, 1rem);
    gap: 0.35rem;
    transform: translateY(-50%) rotate(45deg);
  }

  .textile-motif span {
    width: 1rem;
    height: 1rem;
    border: 2px solid #2fab2e;
  }

  .textile-motif span:nth-child(2n) {
    background: #d9e11a;
    border-color: #d9e11a;
  }

  .textile-motif span:nth-child(5) {
    background: #034d08;
    border-color: #034d08;
  }

  .textile-motif-right {
    transform: translateY(-50%) rotate(45deg) scaleX(-1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section .animate-fade-in,
    .hero-section .animate-slide-down,
    .hero-section .animate-slide-up {
      animation: none;
    }
  }
</style>
